NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# The SERVER connects as the unprivileged app role. This is not a preference:
# Postgres exempts superusers and table owners from row-level security, so
# pointing this at the migration role silently disables tenant isolation.
# The server runs a preflight check at boot and refuses to start if you do.
DATABASE_URL=postgres://dhylapse_app:dhylapse_app@localhost:5432/dhylapse

# Superuser connection. Used only by drizzle-kit and the psql setup steps.
DATABASE_MIGRATION_URL=postgres://dhylapse:dhylapse@localhost:5432/dhylapse

DATABASE_POOL_MAX=10
CORS_ORIGIN=http://localhost:5173

# --- not wired up yet ---
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3001
# GOOGLE_CLIENT_ID=
