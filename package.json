{
  "name": "dhylapse-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node src/server.ts",
    "check": "tsc --noEmit",
    "build": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d",
    "db:verify": "psql \"$DATABASE_MIGRATION_URL\" -f src/db/verify.sql",
    "check:tenant": "node --env-file=.env scripts/tenant-check.ts",
    "lint": "eslint .",
    "check:api": "node --env-file=.env scripts/api-check.ts",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "seed:perf": "node --env-file=.env scripts/seed-perf.ts",
    "perf": "node --env-file=.env scripts/perf-check.ts",
    "test": "pnpm test:unit && pnpm db:verify && pnpm check:tenant && pnpm check:api",
    "seed:demo": "node --env-file=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "drizzle-kit": "^0.31.6",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.2"
  }
}
